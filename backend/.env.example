# Copy to .env and fill real values. NEVER commit real secrets.

APP_ENV=dev

# Data stores — port 55433 (avoids onprem-ai-assistant's 55432)
DATABASE_URL=postgresql+psycopg2://app:app_pass@127.0.0.1:55433/assistant
OLLAMA_URL=http://localhost:11434
# Redis — standalone (default) or Sentinel HA. broker /0, results /1.
REDIS_URL=redis://localhost:6380/0
REDIS_MODE=standalone
REDIS_SENTINELS=
REDIS_MASTER_NAME=mymaster
REDIS_PASSWORD=

# Embeddings (CPU, Ollama)
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# H-Chat LLM — provider: anthropic (ChatAnthropic) | openai (OpenAI-compat, e.g. opencode-go)
# NOTE: leave API key empty to use dev mock. NEVER commit the real key.
H_CHAT_BASE_URL=https://openrouter.ai/api/v1
H_CHAT_API_KEY=
H_CHAT_MODEL=minimax/minimax-m3:free
H_CHAT_PROVIDER=openai
LLM_MAX_TOKENS=800

# RAG
CONFIDENCE_GATE_THRESHOLD=0.75
RETRIEVAL_TOP_K=5
CHUNK_TOKENS=800
CHUNK_OVERLAP=0.10
EMBED_BATCH_SIZE=32

# Confluence (empty → dev sample docs)
CONFLUENCE_BASE_URL=
CONFLUENCE_TOKEN=
CONFLUENCE_SPACE_KEYS=HELP,ITKB

# Jira (empty → link-only mode)
JIRA_BASE_URL=
JIRA_TOKEN=
JIRA_PROJECT=IT

# Auth (Phase 5) — leave LDAP blank for dev fallback (dev / dev)
LDAP_URL=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=(sAMAccountName={username})
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
AUTH_DEV_USER=dev

# RBAC / ACL (Phase 9) — LDAP group roles + domain-scoped access + per-domain Jira
RBAC_ENABLED=true
RBAC_ADMIN_GROUPS=it-help-admins
RBAC_AGENT_GROUPS=it-help-agents
DEV_ADMIN_USERNAMES=dev
ROLE_DOMAINS=user=general,system;agent=database,security,network,system,general;admin=*
# per-domain Jira routing (domain=project,assignee) — e.g. database=IT,db-lead
DOMAIN_JIRA_ROUTING=

# CORS (Phase 10 web/mobile + dev) — comma-separated allowed origins
CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:4173,tauri://localhost,http://tauri.localhost
